NODE_ENV=development
PORT=3000
APP_BASE_URL=http://localhost:5173
API_BASE_URL=http://localhost:3000
COMPOSE_APP_BASE_URL=http://localhost:8080
COMPOSE_API_BASE_URL=http://localhost:8080
DATABASE_URL=postgresql://balcony:balcony@localhost:5432/balcony?schema=public
DATABASE_INTERNAL_URL=postgresql://balcony:balcony@postgres:5432/balcony?schema=public
REDIS_URL=redis://localhost:6379
REDIS_INTERNAL_URL=redis://redis:6379
SESSION_SECRET=replace-with-at-least-32-random-characters
COOKIE_SECURE=false
DEFAULT_TIMEZONE=Asia/Shanghai
S3_ENDPOINT=http://localhost:9000
S3_INTERNAL_ENDPOINT=http://minio:9000
S3_PUBLIC_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=balcony-photos
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_FORCE_PATH_STYLE=true
UPLOAD_MAX_BYTES=15728640
EXPORT_RETENTION_HOURS=24
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=Balcony <no-reply@example.com>
LOG_LEVEL=info
